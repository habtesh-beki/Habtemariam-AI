# Local Postgres from `docker compose up -d`.
DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5434/personal_ai_agent

# Google AI Studio API key. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Token from BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user id. Ask @userinfobot. Separate extra ids with commas.
TELEGRAM_ALLOWED_USER_IDS=

TIMEZONE=Africa/Addis_Ababa
LOG_LEVEL=INFO
